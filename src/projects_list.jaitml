<?jai if projects.count > 0 { ?>
<h2>Projects</h2>
<div class="project-grid">
	<?jai for project: projects { ?>
	<a href="/projects/<?jai echo("%", escape(project.slug)); ?>" class="project-card">
		<img src="<?jai echo("%", escape(project.hero_image)); ?>" />
		<div class="project-info">
			<h3><?jai echo("%", escape(project.title)); ?></h3>
			<p><?jai echo("%", escape(project.description)); ?></p>
		</div>
	</a>
	<?jai } ?>
</div>
<?jai } ?>
