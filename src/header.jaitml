<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<title><?jai echo("%", escape(title)); ?></title>
		<meta name="description" content="<?jai echo("%", escape(description)); ?>"/>
		<meta property="og:site_name" content="<?jai echo("%", escape(SITE_NAME)); ?>"/>
		<meta property="og:title" content="<?jai echo("%", escape(og_title)); ?>"/>
		<meta property="og:description" content="<?jai echo("%", escape(description)); ?>"/>
		<meta property="og:type" content="<?jai echo("%", escape(og_type)); ?>"/>
		<meta property="og:url" content="<?jai echo("%", escape(page_url)); ?>"/>
		<?jai if og_image.count > 0 { ?><meta property="og:image" content="<?jai echo("%", escape(og_image)); ?>"/><?jai if og_image_alt.count > 0 { ?><meta property="og:image:alt" content="<?jai echo("%", escape(og_image_alt)); ?>"/><?jai } ?><?jai } ?>
		<?jai if is_date_set(og_published_time) { ?><meta property="article:published_time" content="<?jai echo("%", format_date(og_published_time)); ?>"/><?jai } ?>
		<?jai if is_date_set(og_modified_time) { ?><meta property="article:modified_time" content="<?jai echo("%", format_date(og_modified_time)); ?>"/><?jai } ?>
		<meta name="viewport" content="width=device-width" />
		<link rel="stylesheet" href="/modern-normalize.css" />
		<link rel="stylesheet" href="/index.css" />
		<link rel="alternate" type="application/rss+xml" title="RSS 2.0" href="/rss.xml"/>	</head>
	<body>
		<header>
			<nav>
				<h1 id="title"><a href="/">Fabian Huber</a></h1>
				<ul class="menu">
					<li><a href="/">Home</a></li>
					<li><a href="/projects">Projects</a></li>
					<li><a href="/posts">Posts</a></li>
					<li><a href="/about">About</a></li>
					<li><a href="/subscribe">Subscribe</a></li>
				</ul>
			</nav>
		</header>
