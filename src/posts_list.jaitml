<?jai if posts.count > 0 { ?>
	<h2>Posts</h2>
	<ul class="posts">
	<?jai for post: posts { ?>
		<li>
			<?jai echo("<a href=\"/posts/%\">%</a>", escape(post.slug), escape(post.title)); ?>
			<?jai if post.description.count > 0 { ?><p class="description"><?jai echo("%", escape(post.description)); ?></p><?jai } ?>
			<p class="date"><time datetime="<?jai echo("%", format_date(post.pub_date_time)); ?>"><?jai echo("%", format_date(post.pub_date_time)); ?></time></p>
		</li>
	<?jai } ?>
	</ul>
<?jai } ?>
